{
  "name": "holdframe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.pure.json",
    "test": "npm run typecheck && vitest run && playwright test",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "demo:record": "playwright test --config playwright.demo.config.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lottie-web": "^5.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mediabunny": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
